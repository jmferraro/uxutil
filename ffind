#!/usr/bin/env bash

usage()
{
  local PGM=$(basename $0)
  echo "Usage: [OPTS] <pattern>"
  echo "where OPTS:"
  echo "  -I      : do *NOT* exclude 'install' dirs"
  echo "  -i      : case-insensitive match (uses -iname instead of -name)"
  echo "  -w      : wildcard - wrap each pattern in '*...*' (ffind -w foo => '*foo*')"
  echo "  -d dir  : specify directory to search (default current dir)"
  echo "  -t type : specify the type of entry to seek (default f)"
  echo "  -h      : this help text"
}

WHERE=.
TYPE=f
NO_INC=1
NAME_OPT=-name
unset WILDCARD
while getopts :Iiwd:t:h opt
do
  case $opt in
    I) unset NO_INC ;;
    i) NAME_OPT=-iname ;;
    w) WILDCARD=1 ;;
    d) WHERE=$OPTARG ;;
    t) TYPE=$OPTARG ;;
    h) usage; exit ;;
    :) echo "Missing argument for '-$OPTARG'"; exit 22 ;;
    *) echo "Invalid argument: '-$OPTARG'"; exit 22 ;;
  esac
done
shift $((OPTIND-1))

[[ 0 -eq $# ]] && { echo "Nothing to do"; exit 22; }

while [[ $# -ne 0 ]]; do
  PATTERN=$1
  [[ -n $WILDCARD ]] && PATTERN="*$1*"
  if [[ -n $NO_INC ]]; then
    find $WHERE -type $TYPE $NAME_OPT "$PATTERN" | fgrep -v /install/
  else
    find $WHERE -type $TYPE $NAME_OPT "$PATTERN"
  fi
  shift
done

