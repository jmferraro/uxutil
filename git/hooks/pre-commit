#!/usr/bin/env bash
# put in .git/hooks

echo "Running pre-commit-hook..."

RET=0
FAIL_REGEX=()
FAIL_REGEX+=("\bFIXME\b")     # items marked as FIXME should be fixed before being committed
FAIL_REGEX+=("\bNOCOMMIT\b")  # explicit DO NOT COMMIT flag
FAIL_REGEX+=("\bXXX\b")       # another flag to stop commits
FAIL_REGEX+=("^<<<<<<<")      # merge conflict marker (matches '<<<<<<< HEAD')
FAIL_REGEX+=("^=======$")     # merge conflict divider (bare 7 '=')
FAIL_REGEX+=("^>>>>>>>")      # merge conflict marker (matches '>>>>>>> branch')
FAIL_REGEX+=("\bNULL\b")      # all NULL should now be nullptr (C++ only, see below)

ROOT_PATH=$(git rev-parse --show-cdup)
[[ -z ${ROOT_PATH} ]] && ROOT_PATH=./

CACHED="--cached"
[[ "--all" == "$1" ]] && unset CACHED

# get a list of the files to be committed: exclude Deleted and Renamed
# --name-status columns are tab-separated: -F'\t' keeps a path containing
# spaces whole, and mapfile splits on newlines only (and never globs)
mapfile -t FILES < <(git diff ${CACHED} --name-status | awk -F'\t' '/^[^DR]/ { print $2 }')
# add Renamed (new name)
mapfile -t RENAMED < <(git diff ${CACHED} --name-status | awk -F'\t' '/^R[0-9]+/ { print $3 }')
FILES+=("${RENAMED[@]}")

# Reject symlinks: cross-project tools live outside the repo and are
# accessed via untracked, locally-created symlinks (so the same source
# can be edited in one place and used from many checkouts).  Tracking a
# symlink defeats this and creates confusing local copies.  Mode 120000
# in --raw output is the symlink type; column 2 is the NEW mode, so
# this catches additions and modifications and ignores deletions.
mapfile -t SYMLINK_FILES < <(git diff ${CACHED} --raw | awk -F'\t' '{ split($1, MODE, " ") } MODE[2] == "120000" { print $NF }')
for FN in "${SYMLINK_FILES[@]}"; do
  echo "$FN is a symlink (not allowed in this repo)"
  RET=$((RET+1))
done

# --- .gitrules: [ignore-commit-scan] -----------------------------------------
# A file whose path contains an entry of the [ignore-commit-scan] section of the
# repository's .gitrules, as whole path components (e.g. "firedancer" or
# "patch/firedancer"), is not scanned; see README.md.  .gitrules lives in the
# main checkout's root, so linked worktrees share it.
COMMON=$(cd "$(git rev-parse --git-common-dir)" && pwd)
RULES_FILE=${COMMON%/.git}/.gitrules

# rules_section NAME - print the entries of [NAME] in RULES_FILE, one per line,
# without comments ('#' to end of line) or surrounding whitespace
rules_section() {
  [[ -r $RULES_FILE ]] || return 0
  awk -v S="[$1]" '{ sub(/#.*/, ""); gsub(/^[ \t\r]+|[ \t\r]+$/, "") }
    /^\[/ { ON = ($0 == S); next } ON && NF' "$RULES_FILE"
}

# .gitrules is local to the checkout, so warn if git does not ignore it (through
# .gitignore, .git/info/exclude or the global ignore file); a tracked .gitrules
# is not ignored
if [[ -e $RULES_FILE ]] && ! git -C "${RULES_FILE%/*}" check-ignore -q .gitrules; then
  echo "WARNING: .gitrules is not ignored, so it could be committed; to ignore it:"
  echo "  echo .gitrules >> \"$COMMON/info/exclude\""
fi

# a leading '/' or './' is dropped; a trailing '/' (kept as one) marks a directory
mapfile -t IGNORE_SCAN < <(rules_section ignore-commit-scan | sed -E 's#^(\./|/)+##; s#/+$#/#')

# an entry marked as a directory must not name anything else (a file, or a link
# to one) in the checkout root
for E in "${IGNORE_SCAN[@]}"; do
  P=${ROOT_PATH}${E%/}
  [[ $E == */ && -e $P && ! -d $P ]] && { echo ".gitrules [ignore-commit-scan]: '$E' is not a directory"; RET=$((RET+1)); }
done

# scan_ignored FILE - true if FILE's path contains an [ignore-commit-scan] entry;
# an entry marked as a directory matches only a directory, never FILE itself
scan_ignored() {
  local E S
  for E in "${IGNORE_SCAN[@]}"; do
    [[ $E == */ ]] && S=/$1 || S=/$1/
    [[ $S == */"${E%/}"/* ]] && return 0
  done
  return 1
}

# loop over all the files
for FN in "${FILES[@]}"; do
  [[ -d "$FN" ]] && { echo "Skipping directory: ${FN}"; continue; }
  [[ "$FN" =~ \.xz$ ]] && { echo "Skipping .xz file: ${FN}"; continue; }
  scan_ignored "$FN" && { echo "Skipping (.gitrules): ${FN}"; continue; }
  for RE in "${FAIL_REGEX[@]}"; do
    # Skip NULL check for .c, .h, and .md files (NULL is valid in C, use nullptr in C++)
    if [[ "$RE" == '\bNULL\b' && "$FN" =~ \.(c|h|md)$ ]]; then
      continue
    fi
    if grep -q -E "${RE}" "${ROOT_PATH}${FN}"; then
      echo "$FN contains $RE"
      RET=$((RET+1))
    fi
  done
  # check for trailing whitespace (skip markdown files - they need trailing spaces for line breaks)
  if [[ ! "$FN" =~ \.md$ ]] && grep -q -E '[[:space:]]+$' "${ROOT_PATH}${FN}"; then
    echo "$FN has trailing whitespace"
    RET=$((RET+1))
  fi
  # check for tabs (use bash $'\t' expansion so BSD grep on macOS works
  # too — BSD grep has no -P flag, only GNU grep does)
  if grep -q $'\t' "${ROOT_PATH}${FN}"; then
    if [[ ! "$FN" =~ (^|/)Makefile$ && ! "$FN" =~ \.mk$ && ! "$FN" =~ \.go$ && ! "$FN" =~ (^|/)go\.(mod|sum|work)$ ]]; then
      echo "$FN has TAB characters"
      RET=$((RET+1))
    fi
  fi
done

if [[ "--all" != "$1" ]]; then
  # check both mod & cached
  # if the file is both cached (staged) and modified, this is likely an oversight
  # the contents of the modified file will be checked, but the version staged will be committed
  mapfile -t MODLIST < <(git diff --name-status | awk -F'\t' '$1 != "D" { print $2 }')
  mapfile -t BOTH < <(comm -12 <(for FN in "${FILES[@]}"; do echo "${FN}"; done|sort) <(for FN in "${MODLIST[@]}"; do echo "${FN}"; done|sort))
  for FN in "${BOTH[@]}"; do
    echo "$FN is both staged and modified"
    RET=$((RET+1))
  done
fi

# exit with number of failures
if [[ $RET -gt 0 ]]; then
  echo "pre-commit hook failed, failure count: $RET"
  exit $RET
fi

# no commits on the default branch, unless the [default-branch] section of
# .gitrules holds allow-commit
if ! rules_section default-branch | grep -qx allow-commit; then
  # get the name of the default branch from the remote repo

  BRNAM=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
  RC=$?

  # should not be committing to the 'main' or 'master' branch
  BRANCH=$(git rev-parse --abbrev-ref HEAD)
  RC=$((RC+$?))
  unset RESTRICT
  if [[ 0 -eq $RC && -n $BRANCH ]]; then
    if [[ -n $BRNAM ]]; then
      # use remote name
      [[ $BRNAM == "$BRANCH" ]] && RESTRICT=1
    else # try usual 'main' branch names
      [[ 'master' == "$BRANCH" ]] && RESTRICT=1
      [[ 'main' == "$BRANCH" ]] && RESTRICT=1
    fi

    if [[ -n $RESTRICT && ${#FILES[@]} -ne 0 ]]; then
      echo "Should not be committing to '$BRANCH' branch"
      echo "  (to allow it, add allow-commit to the [default-branch] section of .gitrules)"
      RET=$((RET+1))
    fi
  fi
fi

exit $RET
