#!/usr/bin/env bash

# mostly:
#  https://github.com/tj/git-extras/

options=""

usage() {
cat <<HERE
usage: git alias [options]                          # list all aliases
   or: git alias [options] <search-pattern>         # show aliases matching pattern
   or: git alias [options] <alias-name> <command>   # alias a command

options:
    --global  Show or create alias in your user config (~/.gitconfig)
              (default when creating an alias)
    --local   Show or create alias in the current repository's config (.git/config)

With neither option, listing and searching show the aliases from every config
(system, user and repository).
HERE
}

if [[ "$1" == "--local" || "$1" == "--global" ]]; then
    options=$1
    shift
fi

# look for help
for ARG in "$@"; do
  if [[ "-h" == "$ARG" || "--help" == "$ARG" ]]; then
    usage
    exit
  fi
done

case $# in
  0)
      if [[ -z "$options" ]]; then
        git config --get-regexp '^alias\.' | sed 's/^alias\.//' | sed 's/[ ]/ = /' | sort
      else
        git config "$options" --get-regexp '^alias\.' | sed 's/^alias\.//' | sed 's/[ ]/ = /' | sort
      fi
      ;;
  1)
      if [[ -z "$options" ]]; then
        git config --get-regexp '^alias\.' | sed 's/^alias\.//' | sed 's/[ ]/ = /' | sort | grep -e "$1"
      else
        git config "$options" --get-regexp '^alias\.' | sed 's/^alias\.//' | sed 's/[ ]/ = /' | sort | grep -e "$1"
      fi
      ;;
  2)
      # aliases are for every project: they go into the user config, and only
      # --local puts one in the current repository's config instead
      git config "${options:---global}" alias."$1" "$2"
      ;;
  *) >&2 echo "error: too many arguments." && usage && exit 1 ;;
esac

