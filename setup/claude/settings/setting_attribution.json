{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/no-attribution.sh\"; [ ! -f \"$HOOK\" ] || exec bash \"$HOOK\""
          }
        ]
      }
    ]
  }
}
